    "%lld pictures in the library plus any photo from your gallery: from 12 pieces to 800, framed the way you like.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pictures in the library plus any photo from your gallery: from 12 pieces to 800, framed the way you like."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld картинки в библиотеке и любое фото из галереи: от 12 деталей до 800, кадрирование на ваш вкус."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Bilder in der Bibliothek plus jedes Foto aus deiner Galerie: von 12 bis 800 Teilen, zugeschnitten wie du willst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld images dans la bibliothèque plus n’importe quelle photo de votre galerie : de 12 à 800 pièces, cadrées comme vous voulez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld imágenes en la biblioteca y cualquier foto de tu galería: de 12 a 800 piezas, encuadradas como prefieras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld immagini in libreria più qualsiasi foto dalla tua galleria: da 12 a 800 pezzi, inquadrate come preferisci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld imagens na biblioteca e qualquer foto da sua galeria: de 12 a 800 peças, enquadradas do seu jeito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリの %lld 枚の絵に加えて、ギャラリーのどの写真でも：12ピースから800ピースまで、好きな切り抜きで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함의 그림 %lld장과 갤러리의 어떤 사진이든: 12조각부터 800조각까지, 원하는 대로 잘라서."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图库中的 %lld 张图片，加上相册里的任意照片：从 12 块到 800 块，裁剪随你喜欢。"
          }
        }
      }
    },
