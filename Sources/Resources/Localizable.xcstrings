      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Original” keeps the whole picture. The other options crop from the centre — nothing is ever stretched."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Как есть» сохраняет всю картинку. Остальные варианты обрезают её по центру — растяжения не бывает никогда."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Original“ behält das ganze Bild. Die anderen Optionen schneiden von der Mitte aus zu – nichts wird jemals verzerrt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Original » conserve toute l’image. Les autres options recadrent depuis le centre — rien n’est jamais déformé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Original» conserva toda la imagen. Las demás opciones recortan desde el centro; nunca se estira nada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Originale” mantiene tutta l’immagine. Le altre opzioni ritagliano dal centro: niente viene mai deformato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Original” mantém a imagem inteira. As outras opções cortam a partir do centro — nada é esticado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「オリジナル」は絵全体をそのまま使います。ほかの設定は中央から切り抜きます。引き伸ばすことはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘원본’은 그림 전체를 유지합니다. 다른 옵션은 가운데를 기준으로 잘라내며, 절대 늘리지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\"原图\"保留整张图片。其他选项从中心裁剪，绝不拉伸。"
          }
        }
      }
    },
